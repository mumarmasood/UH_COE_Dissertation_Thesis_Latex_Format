@article{Yamamoto2016,
abstract = {This paper reports our manufacturing and experimental results of a new small buoyancy control device with silicone rubber for underwater vehicles that utilizes the volume difference of material between solid and liquid states to induce a buoyancy change. First, we compared the stretching characteristics of several materials and chose silicone rubber in terms of specific gravity and heat-proof temperature and manufactured three types of buoyancy control devices that contained a solid or liquid paraffin wax enclosed by silicone rubber. We experimentally confirmed that those devices' volume and buoyancy changed as we expected. In addition, we manufactured two types of heating equipment for our developed buoyancy control device through which hot water flowed and confirmed that the buoyancy change of one of the equipment roughly agreed with the theoretical value.},
author = {Yamamoto, H. and Shibuya, K.},
doi = {10.1142/9789813149137_0032},
