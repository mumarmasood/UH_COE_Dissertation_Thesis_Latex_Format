@inproceedings{Kobayashi2010,
abstract = {Buoyancy engines are key components used in profiling floats and other devices that observe the upper part of the world's oceans. We have proposed and developed a new buoyancy engine for autonomous marine vehicles. It has a reciprocating piston and a three-way valve and can function at pressures as high as 35 MPa (3500 dbar). Use of the new buoyancy engine can increase the observation depth from the 2000 m capability of existing floats to deeper than 3000 m. Laboratory tests verified its good energy efficiency and endurance. Copyright {\textcopyright} 2010 by The International Society of Offshore and Polar Engineers (ISOPE).},
