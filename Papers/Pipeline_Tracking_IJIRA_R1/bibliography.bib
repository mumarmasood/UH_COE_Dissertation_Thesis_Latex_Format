keywords = {Fish Robot,Propulsion System,Robotics,and Underwater Technology},
mendeley-groups = {Under Water Robotics/Robotic Fish/Fish Design},
number = {650},
pages = {711--714},
title = {{Development of Experimental Fish Robot}},
year = {2000}
}
@article{Yu2004,
abstract = {This paper is concerned with the design of a robotic fish and its motion control algorithms. A radio-controlled, four-link biomimetic robotic fish is developed using a flexible posterior body and an oscillating foil as a propeller. The swimming speed of the robotic fish is adjusted by modulating joint's oscillating frequency, and its orientation is tuned by different joint's deflections. Since the motion control of a robotic fish involves both hydrodynamics of the fluid environment and dynamics of the robot, it is very difficult to establish a precise mathematical model employing purely analytical methods. Therefore, the fish's motion control task is decomposed into two control systems. The online speed control implements a hybrid control strategy and a proportional-integral-derivative (PID) control algorithm. The orientation control system is based on a fuzzy logic controller. In our experiments, a point-to-point (PTP) control algorithm is implemented and an overhead vision system is adopted to provide real-time visual feedback. The experimental results confirm the effectiveness of the proposed algorithms. {\textcopyright} 2004 IEEE.},
author = {Yu, Junzhi and Tan, Min and Wang, Shuo and Chen, Erkui},
doi = {10.1109/TSMCB.2004.831151},
file = {:C$\backslash$:/Users/mumar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Yu et al. - 2004 - Development of a biomimetic robotic fish and its control algorithm.pdf:pdf},
issn = {10834419},
journal = {IEEE Transactions on Systems, Man, and Cybernetics, Part B: Cybernetics},
mendeley-groups = {Under Water Robotics/Robotic Fish,Under Water Robotics/Robotic Fish/Fish Design},
number = {4},
pages = {1798--1810},
pmid = {15462446},
title = {{Development of a biomimetic robotic fish and its control algorithm}},
volume = {34},
year = {2004}
}
@article{Liu2005,
abstract = {This paper presents a novel mechatronics design for a 3D swimming robotic fish, namely MT1 (Mechanical Tail) robotic fish. It has a novel tail structure which uses only one motor to generate fish-like swimming motion using C-bends tail shapes. This design enables MT1 to become the first small size robotic fish ({\textless}0.5m in length) and be able to dive over 3 meters deep in water. An effective control method with only 5 parameters is proposed to control its 3D swimming behaviours. Experimental results are presented to show the feasibility and good performance of the proposed control algorithms. {\textcopyright} 2005 IEEE.},
author = {Liu, Jindong and Dukes, Ian and Hu, Huosheng},
doi = {10.1109/IROS.2005.1545283},
file = {:C$\backslash$:/Users/mumar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Liu, Dukes, Hu - 2005 - Novel mechatronics design for a robotic fish.pdf:pdf},
isbn = {0780389123},
journal = {2005 IEEE/RSJ International Conference on Intelligent Robots and Systems, IROS},
keywords = {3D swimming,C-bends,Robotic fish},
mendeley-groups = {Under Water Robotics/Robotic Fish,Under Water Robotics/Robotic Fish/Fish Design},
pages = {807--812},
title = {{Novel mechatronics design for a robotic fish}},
year = {2005}
}
@article{Yu2005,
abstract = {This paper presents a simplified kinematics propulsive model for carangiform propulsion. The carangiform motion is modeled as a serial N -joint oscillating mechanism that is composed of two basic components: the streamlined fish body represented by a planar spline curve and its lunate caudal tail by an oscillating foil. The speed of fish's straight swimming is adjusted by modulating the joint's oscillatory frequency, and its orientation is tuned by different joint's deflections. The experimental results showed that the proposed simplified propulsive model could be a viable candidate for application in aquatic swimming vehicles.},
author = {Yu, Junzhi and Wang, Shuo and Tan, Min},
doi = {10.1017/S0263574704000426},
file = {:C$\backslash$:/Users/mumar/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Yu, Wang, Tan - 2005 - A simplified propulsive model of bio-mimetic robot fish and its realization.pdf:pdf},
